{
  "name": "pool-mate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PoolMate — instant-first intra-city carpooling web prototype (frontend only).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "esbuild tests/pooling.test.ts --bundle --platform=node --format=cjs --alias:@=./src --log-level=warning --outfile=node_modules/.cache/poolmate/pooling.test.cjs && node node_modules/.cache/poolmate/pooling.test.cjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
