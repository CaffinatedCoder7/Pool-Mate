.env
.env.local
.env.*.local

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Upload bundles
poolmate-upload*.zip
