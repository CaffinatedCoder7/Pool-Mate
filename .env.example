# Copy to .env.local to override. Only VITE_* variables are exposed to the browser —
# never put secrets or private API keys here.

# Base URL of the future FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# "true" (default) uses typed mock services. Set to "false" once real adapters exist.
VITE_USE_MOCK_SERVICES=true
